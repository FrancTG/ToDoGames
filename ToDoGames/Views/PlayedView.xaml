<UserControl x:Class="ToDoGames.Views.PlayedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToDoGames.Views"
             xmlns:viewModel="clr-namespace:ToDoGames.ViewModel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:PlayedViewModel}"
             FontFamily="Rubik"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <viewModel:ScoreToColorConverter x:Key="hola" />
    </UserControl.Resources>
    <Grid>
        <ListBox Grid.Row="1"
              Name="GamesListView"
              ItemsSource="{Binding Path = PlayedGames}"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="250" MinHeight="250">
                        
                        <Border CornerRadius="5" Width="220" Height="150" Margin="0 10"  VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Command="{Binding ElementName=GamesListView, Path=DataContext.RemoveGameCommand}" CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="TrashCan" Width="15" Height="15" Foreground="#FFFFFF" />
                                </Button>
                                <Button Command="{Binding ElementName=GamesListView, Path=DataContext.EditGameCommand}" CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Foreground="#FFFFFF" />
                                </Button>
                            </StackPanel>
                            
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding BackgroundImage}"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="white" FontSize="22" FontWeight="bold" HorizontalAlignment="Center" Margin="0 10 5 0" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                            <TextBlock Text="Añadido el: " Foreground="LightGray" />
                            <TextBlock Text="{Binding AddedDate}" Foreground="LightGray" />
                        </StackPanel>
                        <materialDesign:PopupBox HorizontalAlignment="Center"
                                 PlacementMode="TopAndAlignCentres"
                                 PopupMode="MouseOver"
                                 StaysOpen="True">
                            <materialDesign:PopupBox.PopupContent>
                                <ListBox >
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Gráficos" Width="100" />
                                            <TextBlock Text="{Binding Score.Graphics}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Historia" Width="100" />
                                            <TextBlock Text="{Binding Score.Story}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Jugabilidad" Width="100" />
                                            <TextBlock Text="{Binding Score.Gameplay}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bugs" Width="100" />
                                            <TextBlock Text="{Binding Score.Bugs}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Duración" Width="100" />
                                            <TextBlock Text="{Binding Score.Length}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Rendimiento" Width="100" />
                                            <TextBlock Text="{Binding Score.Performance}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Música" Width="100" />
                                            <TextBlock Text="{Binding Score.Music}" />
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel>
                                            <TextBlock Text="Comentarios adicionales:" Width="200" />
                                            <TextBlock Text="{Binding Score.AdditionalComment}" Width="200" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                            </materialDesign:PopupBox.PopupContent>
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:Badged Badge="2"
                                       x:Name="MainMenuButton"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Score.Overall}" Foreground="{Binding Path=Score.Overall, Converter={StaticResource hola}}" FontSize="20" FontWeight="bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Badged>
                            </materialDesign:PopupBox.ToggleContent>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>
