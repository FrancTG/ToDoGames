<UserControl x:Class="ToDoGames.Views.ApiGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToDoGames.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModel="clr-namespace:ToDoGames.ViewModel" d:DataContext="{d:DesignInstance Type=viewModel:ApiGameViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <viewModel:ApiGameViewModel x:Key="apigames"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border CornerRadius="8" BorderBrush="#4CFFFFFF" BorderThickness="1" Width="500" Background="#26FFFFFF">
                <TextBox x:Name="availableGamesTextBox"  HorizontalAlignment="left" Width="500" Foreground="White" FontSize="18" FontFamily="Segoe UI Semibold" TextAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Command="{Binding Path=BuscarJuegosApiCommand}" CommandParameter="{Binding RelativeSource= {RelativeSource FindAncestor, AncestorType={x:Type TextBox}, AncestorLevel=1}}" Key="Return" />
                    </TextBox.InputBindings>
                </TextBox>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <ListBox Grid.Row="1"
                     Name="apiGamesListView"
                     ItemsSource="{Binding ApiGames}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="250" MinHeight="250">
                            <TextBlock Text="{Binding name}" Foreground="white" FontSize="22" FontWeight="bold" HorizontalAlignment="Center" Margin="0 10 5 0" TextWrapping="Wrap" TextAlignment="Center" />
                            <Border CornerRadius="5" Width="220" Height="150" Margin="0 10"  VerticalAlignment="Top">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding background_image}"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding released}" Foreground="LightGray" FontSize="14" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Valorar" 
                                        Command="{Binding ElementName=apiGamesListView, Path=DataContext.RateGameCommand}"
                                        CommandParameter="{Binding}"
                                        Foreground="White"/>
                                <Button Content="Guardar"
                                        Command="{Binding ElementName=apiGamesListView, Path=DataContext.AddGameToPlayCommand}"
                                        CommandParameter="{Binding}" 
                                        Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
