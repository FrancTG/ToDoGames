<UserControl x:Class="ToDoGames.Views.ToPlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToDoGames.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModel="clr-namespace:ToDoGames.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewModel:ToPlayViewModel}"
             mc:Ignorable="d"
             FontFamily="Rubik"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="5 15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ListBox Grid.Row="1"
              Name="GamesListView"
              ItemsSource="{Binding Path = GamesToPlay}"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="250" MinHeight="300">
                        <TextBlock Text="{Binding Name}" Foreground="white" FontSize="22" FontWeight="bold" HorizontalAlignment="Center" Margin="10 5" TextWrapping="Wrap"  TextAlignment="Center" />
                        <TextBlock Text="{Binding Released}" Foreground="LightGray" FontSize="13" TextAlignment="Center" />
                        <Border CornerRadius="5" Width="220" Height="150" Margin="0 10">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding BackgroundImage}"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Añadido el: " Foreground="LightGray" FontSize="10" />
                            <TextBlock Text="{Binding AddedDate}" Foreground="LightGray" FontSize="10" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="RateButton"
                                    Content="Valorar"
                                    Command="{Binding ElementName=GamesListView, Path=DataContext.RateGameCommand}"
                                    CommandParameter="{Binding}" />
                            <Button x:Name="RemoveButton"
                                    Content="Eliminar"
                                    Command="{Binding ElementName=GamesListView, Path=DataContext.RemoveGameCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>
