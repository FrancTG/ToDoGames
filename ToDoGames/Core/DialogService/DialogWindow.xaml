<Window x:Class="ToDoGames.Core.DialogService.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoGames.Core.DialogService"
        xmlns:viewmodel="clr-namespace:ToDoGames.Core.DialogService" d:DataContext="{d:DesignInstance Type=viewmodel:DialogViewModel}"
        xmlns:core="clr-namespace:ToDoGames.Core"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
        fw:AcrylicWindow.Enabled="True"
        Background="Transparent"
        BorderBrush="Transparent"
        Foreground="white"
        FontFamily="Rubik"
        FontSize="16"
        x:Name="DialogWin"
        WindowStartupLocation="CenterScreen"
        Title="Valorar nuevo juego" Icon="../../img/racon-icon.ico" Width="400">
    <StackPanel Background="#CC00040C">
        <StackPanel Margin="30">
            <Image Source="{Binding Path=PlayedGame.BackgroundImage}" Height="200" Stretch="UniformToFill" />
            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PlayedGame.Name}" Margin="0 10 0 10" TextAlignment="Center" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gráficos" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Graphics}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Historia" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Story}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jugabilidad" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Gameplay}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Bugs" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Bugs}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Duración" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Length}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rendimiento" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Performance}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Música" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Music}"/>
                    <TextBlock Grid.Column="2" Text="/10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Valoración general" HorizontalAlignment="Center" FontWeight="bold"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                    <TextBox Grid.Column="1" PreviewTextInput="NumberValidationTextBox" Width="20" BorderBrush="white" Text="{Binding PlayedGame.Score.Overall}"/>
                    <TextBlock Grid.Column="2" Text="/100" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel>
                <TextBlock Text="Comentarios adicionales:" HorizontalAlignment="Stretch" FontSize="12" Margin="0 10"/>
                <TextBox Text="{Binding PlayedGame.Score.AdditionalComment}" Height="100" Background="#19FFFFFF" HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                <Button Content="Valorar" Background="red" Width="100" FontSize="20" Foreground="White"
                    Command="{Binding Path=RateGameCommand}" CommandParameter="{Binding ElementName=DialogWin}" Cursor="Hand">
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
